<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Uhren Eleganz</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
  </style>
</head>
<body class="bg-white text-gray-900">
  <!-- Navigation -->
  <header class="flex justify-between items-center p-6 shadow-md">
    <h1 class="text-2xl font-semibold">Uhren Eleganz</h1>
    <nav class="space-x-6">
      <a href="#" class="hover:underline">Start</a>
      <a href="#produkte" class="hover:underline">Produkte</a>
      <a href="#ueber" class="hover:underline">Über uns</a>
      <a href="#kontakt" class="hover:underline">Kontakt</a>
    </nav>
  </header>

  <!-- Hero -->
  <section class="text-center py-20 bg-gray-100">
    <h2 class="text-5xl font-semibold mb-4">Zeitlose Eleganz</h2>
    <p class="text-xl text-gray-600 mb-8">Entdecke unsere exklusive Uhrenkollektion</p>
    <button class="bg-black text-white px-6 py-3 rounded-full hover:bg-gray-800 transition">Jetzt entdecken</button>
  </section>

  <!-- Produkte -->
  <section id="produkte" class="py-16 px-6">
    <h3 class="text-3xl font-semibold text-center mb-12">Unsere Uhren</h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-12 max-w-6xl mx-auto">
      <div class="text-center">
        <img src="https://via.placeholder.com/300" alt="Uhr 1" class="mx-auto mb-4 rounded-lg shadow" />
        <h4 class="text-xl font-semibold">Classic Black</h4>
        <p class="text-gray-600">€199</p>
      </div>
      <div class="text-center">
        <img src="https://via.placeholder.com/300" alt="Uhr 2" class="mx-auto mb-4 rounded-lg shadow" />
        <h4 class="text-xl font-semibold">Silver Touch</h4>
        <p class="text-gray-600">€249</p>
      </div>
      <div class="text-center">
        <img src="https://via.placeholder.com/300" alt="Uhr 3" class="mx-auto mb-4 rounded-lg shadow" />
        <h4 class="text-xl font-semibold">Modern Minimal</h4>
        <p class="text-gray-600">€179</p>
      </div>
    </div>
  </section>

  <!-- Über uns -->
  <section id="ueber" class="bg-gray-100 py-16 px-6">
    <div class="max-w-3xl mx-auto text-center">
      <h3 class="text-3xl font-semibold mb-6">Über uns</h3>
      <p class="text-gray-700 text-lg">Unsere Mission ist es, hochwertige und stilvolle Uhren zu entwerfen, die den modernen Lebensstil widerspiegeln. Jedes Modell wird mit Präzision und Liebe zum Detail gefertigt.</p>
    </div>
  </section>

  <!-- Kontakt -->
  <section id="kontakt" class="py-16 px-6">
    <div class="max-w-xl mx-auto">
      <h3 class="text-3xl font-semibold text-center mb-6">Kontakt</h3>
      <form class="space-y-4">
        <input type="text" placeholder="Name" class="w-full border border-gray-300 rounded px-4 py-2" />
        <input type="email" placeholder="E-Mail" class="w-full border border-gray-300 rounded px-4 py-2" />
        <textarea placeholder="Nachricht" class="w-full border border-gray-300 rounded px-4 py-2 h-32"></textarea>
        <button type="submit" class="bg-black text-white px-6 py-3 rounded-full hover:bg-gray-800 transition">Absenden</button>
      </form>
    </div>
  </section>

  <!-- Footer -->
  <footer class="text-center py-6 text-gray-500 border-t mt-10">
    &copy; 2025 Uhren Eleganz – Alle Rechte vorbehalten
  </footer>
</body>
</html>
